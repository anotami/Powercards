# ─────────────────────────────────────────────────────────────
# Powercards — variables de entorno (copiar a .env)
# ─────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL). Local: docker compose up -d
# Producción gratis: Neon (neon.tech) o Supabase — pegar su connection string.
DATABASE_URL="postgresql://powercards:powercards@localhost:5432/powercards?schema=public"

# API
API_PORT=8787
# URL pública de la API. Apple Wallet exige HTTPS en producción.
PUBLIC_API_URL="http://localhost:8787"
# Orígenes permitidos (CORS) — dashboard y scanner en GitHub Pages
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://anotami.github.io"
# openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# ── Apple Wallet (requiere Apple Developer Program, USD 99/año) ──
APPLE_TEAM_ID=""
APPLE_PASS_TYPE_ID="pass.pe.powercards.loyalty"
# Rutas a los certificados (carpeta certs/ está en .gitignore)
APPLE_WWDR_CERT_PATH="./certs/wwdr.pem"
APPLE_SIGNER_CERT_PATH="./certs/signerCert.pem"
APPLE_SIGNER_KEY_PATH="./certs/signerKey.pem"
APPLE_SIGNER_KEY_PASSPHRASE=""
# APNs (push para actualizar pases) — mismo certificado del Pass Type ID
APNS_PRODUCTION=true

# ── Google Wallet (gratis) ──
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_SERVICE_ACCOUNT_PATH="./certs/google-service-account.json"

# ── Frontends (Vite) ──
VITE_API_URL="http://localhost:8787"
